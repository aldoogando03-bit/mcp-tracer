{
  "name": "mcp-tracer",
  "version": "0.1.0",
  "description": "MCP server that lets any AI agent design Cisco Packet Tracer topologies by generating PTBuilder scripts.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "packet-tracer",
    "cisco",
    "ptbuilder",
    "networking",
    "ccna",
    "network-topology",
    "claude",
    "ai-agents"
  ],
  "homepage": "https://mcp-tracer-web.vercel.app",
  "bugs": {
    "url": "https://github.com/aldoogando03-bit/mcp-tracer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldoogando03-bit/mcp-tracer.git"
  },
  "license": "MIT",
  "author": "Aldo Ariel Ogando Peña (A-TECH)",
  "type": "module",
  "bin": {
    "mcp-tracer": "build/index.js"
  },
  "files": [
    "build",
    "docs/PTBUILDER_API.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "npm run build && node scripts/build-examples.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "vite": "7.3.7"
  }
}
